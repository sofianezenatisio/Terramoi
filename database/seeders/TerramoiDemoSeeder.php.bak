<?php

namespace Database\Seeders;

use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\DB;
use RuntimeException;

class TerramoiDemoSeeder extends Seeder
{
    public function run(): void
    {
        DB::transaction(function (): void {
            $sites = DB::table('sites')->orderBy('id')->get();

            if ($sites->count() !== 10) {
                throw new RuntimeException(
                    'Le seeder attend exactement 10 sites.'
                );
            }

            $types = DB::table('type_parcelles')
                ->orderBy('id')
                ->pluck('id')
                ->values();

            if ($types->count() < 3) {
                throw new RuntimeException(
                    'Il faut au moins 3 types de parcelles.'
                );
            }

            $repartition = [
                14, 12, 11, 10, 10,
                10, 9, 9, 8, 7,
            ];

            $loueesParSite = [
                9, 7, 7, 6, 6,
                6, 5, 5, 5, 4,
            ];

            $clientExistant = DB::table('clients')
                ->where('id', 1)
                ->first();

            if (!$clientExistant) {
                throw new RuntimeException(
                    'Le client id=1 est introuvable.'
                );
            }

            DB::table('clients')->where('id', 1)->update([
                'nom' => $clientExistant->nom ?: 'Martin',
                'prenom' => $clientExistant->prenom ?: 'Alex',
                'email' => $clientExistant->email
                    ?: 'alex.martin.demo@terramoi.test',
                'telephone' => $clientExistant->telephone
                    ?: '0600000001',
                'adresse' => $clientExistant->adresse
                    ?: '1 rue des Jardins, 94000 Créteil',
                'updated_at' => now(),
            ]);

            $noms = [
                ['Bernard', 'Camille'],
                ['Dubois', 'Thomas'],
                ['Thomas', 'Léa'],
                ['Robert', 'Hugo'],
                ['Richard', 'Emma'],
                ['Petit', 'Louis'],
                ['Durand', 'Chloé'],
                ['Leroy', 'Nathan'],
                ['Moreau', 'Inès'],
                ['Simon', 'Jules'],
                ['Laurent', 'Manon'],
                ['Lefebvre', 'Gabriel'],
                ['Michel', 'Sarah'],
                ['Garcia', 'Adam'],
                ['David', 'Jade'],
                ['Bertrand', 'Noah'],
                ['Roux', 'Zoé'],
                ['Vincent', 'Paul'],
                ['Fournier', 'Alice'],
                ['Morel', 'Ethan'],
                ['Girard', 'Lina'],
                ['André', 'Raphaël'],
                ['Lefèvre', 'Nina'],
                ['Mercier', 'Malo'],
                ['Dupont', 'Louise'],
                ['Lambert', 'Sacha'],
                ['Bonnet', 'Mila'],
                ['François', 'Léo'],
                ['Martinez', 'Eva'],
                ['Legrand', 'Noé'],
                ['Garnier', 'Anna'],
                ['Faure', 'Mathis'],
                ['Rousseau', 'Rose'],
                ['Blanc', 'Yanis'],
                ['Guerin', 'Lola'],
                ['Muller', 'Enzo'],
                ['Henry', 'Aya'],
                ['Roussel', 'Ilyes'],
                ['Nicolas', 'Clara'],
            ];

            foreach ($noms as $index => [$nom, $prenom]) {
                $numero = $index + 2;

                DB::table('clients')->updateOrInsert(
                    ['email' => sprintf(
                        'client%02d.demo@terramoi.test',
                        $numero
                    )],
                    [
                        'nom' => $nom,
                        'prenom' => $prenom,
                        'telephone' => sprintf('060000%04d', $numero),
                        'adresse' => sprintf(
                            '%d rue des Jardins, 94000 Créteil',
                            $numero
                        ),
                        'created_at' => now(),
                        'updated_at' => now(),
                    ]
                );
            }

            $clients = DB::table('clients')
                ->orderBy('id')
                ->limit(40)
                ->get();

            if ($clients->count() !== 40) {
                throw new RuntimeException(
                    'Le seeder doit disposer de 40 clients.'
                );
            }

            $equipements = [
                'Serre' => 15,
                'Kit outils' => 5,
                "Récupérateur d'eau" => 5,
                'Composteur' => 3,
            ];

            foreach ($equipements as $libelle => $tarif) {
                DB::table('equipements')->updateOrInsert(
                    ['libelle' => $libelle],
                    [
                        'tarif_mensuel' => $tarif,
                        'created_at' => now(),
                        'updated_at' => now(),
                    ]
                );
            }

            $idsEquipements = DB::table('equipements')
                ->whereIn('libelle', array_keys($equipements))
                ->pluck('id', 'libelle');

            $aConserver = collect();
            $parcellesParSite = [];

            foreach ($sites as $index => $site) {
                $parcelles = DB::table('parcelles')
                    ->where('site_id', $site->id)
                    ->orderBy('id')
                    ->get();

                if ($parcelles->count() < $repartition[$index]) {
                    throw new RuntimeException(
                        "Pas assez de parcelles pour le site {$site->id}."
                    );
                }

                $selection = collect();

                if ($index === 0) {
                    $premiere = $parcelles->firstWhere('id', 1);

                    if (!$premiere) {
                        throw new RuntimeException(
                            'La parcelle id=1 doit être conservée.'
                        );
                    }

                    $selection->push($premiere);
                }

                foreach ($parcelles as $parcelle) {
                    if (
                        $selection->count() >= $repartition[$index]
                    ) {
                        break;
                    }

                    if (!$selection->contains('id', $parcelle->id)) {
                        $selection->push($parcelle);
                    }
                }

                $selection = $selection->values();

                foreach ($selection as $position => $parcelle) {
                    $statut = $position < $loueesParSite[$index]
                        ? 'Louée'
                        : 'Disponible';

                    DB::table('parcelles')
                        ->where('id', $parcelle->id)
                        ->update([
                            'statut' => $statut,
                            'type_parcelle_id' => $types[
                                $position % $types->count()
                            ],
                            'updated_at' => now(),
                        ]);
                }

                $idsSelection = $selection->pluck('id');

                $utiliseesHorsSelection = DB::table('locations')
                    ->where('parcelle_id', '!=', 0)
                    ->whereIn(
                        'parcelle_id',
                        $parcelles->pluck('id')->diff($idsSelection)
                    )
                    ->exists();

                if ($utiliseesHorsSelection) {
                    throw new RuntimeException(
                        "Une parcelle excédentaire du site {$site->id} "
                        . 'est encore liée à une location.'
                    );
                }

                DB::table('parcelles')
                    ->where('site_id', $site->id)
                    ->whereNotIn('id', $idsSelection)
                    ->delete();

                $aConserver = $aConserver->merge($selection);
                $parcellesParSite[$site->id] = $selection;
            }

            $total = DB::table('parcelles')->count();

            if ($total !== 100) {
                throw new RuntimeException(
                    "Résultat inattendu : {$total} parcelles."
                );
            }

            $locationExistante = DB::table('locations')
                ->where('parcelle_id', 1)
                ->first();

            if (!$locationExistante) {
                throw new RuntimeException(
                    'La location de la parcelle 1 doit être conservée.'
                );
            }

            $idsParcellesLouees = DB::table('parcelles')
                ->where('statut', 'Louée')
                ->orderBy('id')
                ->pluck('id');

            $idsParcellesLoueesSansLocation = $idsParcellesLouees
                ->diff(
                    DB::table('locations')->pluck('parcelle_id')
                );

            foreach ($idsParcellesLoueesSansLocation as $parcelleId) {
                $client = $clients[
                    ($parcelleId - 1) % $clients->count()
                ];

                $locationId = DB::table('locations')->insertGetId([
                    'date' => now()->toDateString(),
                    'date_location' => now()->toDateString(),
                    'date_paiement' => null,
                    'client_id' => $client->id,
                    'parcelle_id' => $parcelleId,
                    'created_at' => now(),
                    'updated_at' => now(),
                ]);

                $choix = [
                    $idsEquipements['Serre'],
                    $idsEquipements['Kit outils'],
                    $idsEquipements["Récupérateur d'eau"],
                    $idsEquipements['Composteur'],
                ];

                foreach (array_slice($choix, 0, 2 + ($parcelleId % 3)) as $equipementId) {
                    DB::table('location_equipement')->insertOrIgnore([
                        'location_id' => $locationId,
                        'equipement_id' => $equipementId,
                        'created_at' => now(),
                        'updated_at' => now(),
                    ]);
                }
            }

            foreach ($sites as $site) {
                $collectifs = [
                    'Point d’eau' => 4,
                    'Local à outils' => 2,
                    'Composteur collectif' => 3,
                    'Parking voiture' => 1,
                ];

                foreach ($collectifs as $libelle => $nombre) {
                    for ($i = 1; $i <= $nombre; $i++) {
                        DB::table('equipement_sites')->updateOrInsert(
                            [
                                'site_id' => $site->id,
                                'libelle' => "{$libelle} {$i}",
                            ],
                            [
                                'created_at' => now(),
                                'updated_at' => now(),
                            ]
                        );
                    }
                }
            }

            $services = [
                'Débroussaillage' => 30,
                'Arrosage de la parcelle' => 15,
                'Bêchage' => 40,
                'Retrait des mauvaises herbes' => 25,
            ];

            foreach ($services as $type => $prix) {
                $demande = DB::table('demandes')
                    ->where('client_id', 1)
                    ->where('consultation', "Prestation demandée : {$type}")
                    ->first();

                if (!$demande) {
                    $demandeId = DB::table('demandes')->insertGetId([
                        'client_id' => 1,
                        'consultation' => "Prestation demandée : {$type}",
                        'statut' => 'Nouvelle demande',
                        'created_at' => now(),
                        'updated_at' => now(),
                    ]);
                } else {
                    $demandeId = $demande->id;
                }

                DB::table('prestations')->updateOrInsert(
                    [
                        'demande_id' => $demandeId,
                        'type' => $type,
                    ],
                    [
                        'prix' => $prix,
                        'created_at' => now(),
                        'updated_at' => now(),
                    ]
                );
            }

            $louees = DB::table('parcelles')
                ->where('statut', 'Louée')
                ->count();

            $disponibles = DB::table('parcelles')
                ->where('statut', 'Disponible')
                ->count();

            if ($louees !== 60 || $disponibles !== 40) {
                throw new RuntimeException(
                    "Répartition invalide : {$louees} louées, "
                    . "{$disponibles} disponibles."
                );
            }

            if (DB::table('locations')->count() !== 60) {
                throw new RuntimeException(
                    'Il doit exister exactement 60 locations.'
                );
            }
        });
    }
}
